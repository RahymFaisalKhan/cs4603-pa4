# ─── Databricks Model Serving (LLM) ─────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_MODEL=databricks-meta-llama-3-3-70b-instruct

# ─── Embeddings (managed by the Vector Search index) ────────────────────────
EMBEDDINGS_ENDPOINT=databricks-gte-large-en

# ─── Unity Catalog + Vector Search ──────────────────────────────────────────
UC_CATALOG=main
UC_SCHEMA=default
# Optional comma-separated override. By default Part 1 uses growth_rate,
# percentage_change, compare_values, and to_billions in UC_CATALOG.UC_SCHEMA.
UC_FUNCTION_NAMES=
# Optional Databricks CLI profile used by uc_tools/register_functions.py.
DATABRICKS_PROFILE=
DATABRICKS_WAREHOUSE_ID=
VECTOR_SEARCH_ENDPOINT=<your-name>-vs-endpoint
VECTOR_SEARCH_INDEX=main.default.<your-name>_analyst_index

# ─── AI/BI Genie structured retrieval (Part 2) ──────────────────────────────
# Set after running `python -m genie.build_space`.
GENIE_SPACE_ID=

# ─── Source Delta table produced by rag/ingest.py ───────────────────────────
SOURCE_TABLE=main.default.<your-name>_analyst_chunks

# ─── Deployment ─────────────────────────────────────────────────────────────
SERVING_ENDPOINT_NAME=<your-name>-document-analyst
# Optional existing Agent Framework endpoint to update for Part 1. Reusing one
# avoids consuming another serving-endpoint slot in quota-limited workspaces.
UC_AGENT_ENDPOINT_NAME=
# Optional existing endpoint to update for the Part 2 multi-source agent.
MULTI_AGENT_ENDPOINT_NAME=
# Application ID of the deployed endpoint's system service principal. Use with
# genie/grant_data_access.py for least-privilege access to the Space's tables.
MULTI_AGENT_DATA_PRINCIPAL=
SECRET_SCOPE=cs4603-deploy

# ─── Bonus C: standalone MCP Databricks App (optional) ──────────────────────
# Leave unset to use the bundled stdio MCP server from Part 1.
MCP_SERVER_URL=
# Store these in SECRET_SCOPE; never commit real OAuth credentials.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
